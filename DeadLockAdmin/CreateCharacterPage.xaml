<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DeadLockAdmin.CreateCharacterPage"
             Title="CreateCharacterPage">
    <StackLayout Padding="10">
        <Entry x:Name="CharacterNameEntry" Placeholder="Введите имя персонажа" />
        <Button Text="Выбрать изображение" Clicked="OnPickImageClicked" />
        <Image x:Name="SelectedImage" WidthRequest="200" HeightRequest="200" />
        <Button Text="Создать персонажа" Clicked="OnCreateCharacterClicked"/>
    </StackLayout>
</ContentPage>